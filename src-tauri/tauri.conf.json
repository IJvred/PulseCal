{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PulseCal",
  "version": "0.1.0",
  "identifier": "com.limitless.pulsecal",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "windows": [
      {
        "title": "PulseCal",
        "width": 1200,
        "height": 800,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/icon.ico"]
  },
  "plugins": {
    "sql": {
      "default": {
        "preload": [
          {
            "name": "sqlite:pulsecal.db",
            "path": "sqlite:pulsecal.db"
          }
        ]
      }
    }
  }
}
